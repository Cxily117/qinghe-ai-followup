# 统一编辑器行为，避免"我这里是 CRLF / 你那里是 LF"这类无意义 diff
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml,md}]
indent_size = 2

[*.md]
# Markdown 行尾两个空格表示换行，不能被自动删掉
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
