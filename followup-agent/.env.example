# ===== 复制为 .env 后按需修改（不要把 .env 提交到仓库）=====

# ---- 数据库 ----
# 开发态默认 SQLite，零依赖直接跑
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# 生产态（PostgreSQL + pgvector，见 docker-compose.yml）：
# DATABASE_URL=postgresql+asyncpg://followup:followup@localhost:5433/followup

# ---- JWT ----
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- LLM 网关 ----
# mock：离线联调，无需 Key；openai：任何 OpenAI 兼容接口（智谱/DeepSeek/通义/vLLM）
#
# Key 使用约定（长期用同一个 Key 是常态，但必须守住三条）：
#   1. 只写在本文件复制出来的 .env 里；.env 已被 .gitignore 忽略，永远不进仓库。
#      不要把 Key 写进代码、README、issue、聊天记录或截图。
#   2. 对话与向量化共用一个 Key（智谱 /chat/completions 与 /embeddings 同一鉴权）。
#      开发与生产建议各配一个，方便单独限额、单独作废，出事不影响另一套。
#   3. 换 Key / 换模型后先跑体检，再重启服务：
#          python scripts/check_llm.py --verbose
#      退出码 0 才说明「配置对、Key 通、向量维度一致」。
LLM_PROVIDER=mock
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_CHAT_MODEL=glm-4-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# ---- Embedding ----
# 注意：EMBED_PROVIDER=mock 的向量没有真实语义，只能验证链路
#      真实检索质量必须把 EMBED_PROVIDER 设为 openai 并配好 Key
# ⚠️ 从 mock 切到真实模型后，必须重建历史切片向量，否则查询向量与库存向量
#    不在同一语义空间（检索会看起来能跑但引错条文）：
#        python scripts/reindex_embeddings.py --all
EMBED_PROVIDER=mock
EMBED_MODEL=embedding-3
# 必须与 pgvector 的 vector(N) 定义一致；改动后需重建知识库切片向量
EMBED_DIM=1024

# ---- RAG 参数 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_ALPHA=0.5
RAG_MAX_CANDIDATES=5000

# ---- 知识库原始文件留档目录 ----
KB_STORAGE_DIR=data/kb
