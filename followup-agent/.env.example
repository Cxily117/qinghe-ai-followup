# ===== 复制为 .env 后按需修改（不要提交 .env 到仓库）=====

# 数据库：开发态默认 SQLite，零依赖直接跑
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# 生产态（PostgreSQL + pgvector，见 docker-compose.yml）：
# DATABASE_URL=postgresql+asyncpg://followup:followup@localhost:5433/followup

# JWT 密钥：生产环境务必替换为长随机串
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ===== 以下为阶段 3 接入 LLM 时使用，D1–D2 不生效 =====
LLM_PROVIDER=mock
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_CHAT_MODEL=glm-4-flash
EMBED_MODEL=embedding-3
EMBED_DIM=1024
